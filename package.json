{
    "name": "indexed-vir",
    "version": "1.0.2",
    "description": "ridiculously simple wrapper for IndexedDB",
    "keywords": [
        "db",
        "indexedDB",
        "simple",
        "vir"
    ],
    "homepage": "https://github.com/electrovir/indexed-vir",
    "bugs": {
        "url": "https://github.com/electrovir/indexed-vir/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/electrovir/indexed-vir.git"
    },
    "license": "(MIT OR CC0-1.0)",
    "author": {
        "name": "electrovir",
        "url": "https://github.com/electrovir"
    },
    "sideEffects": false,
    "type": "module",
    "main": "src/index.ts",
    "module": "src/index.ts",
    "types": "src/index.ts",
    "scripts": {
        "build": "virmator frontend build",
        "compile": "virmator compile",
        "docs": "virmator docs",
        "format": "virmator format",
        "lint": "virmator lint fix",
        "publish": "virmator publish npm run test:all",
        "start": "virmator frontend",
        "test": "virmator test web",
        "test:all": "npm run compile && runstorm --names tests,spelling,format,docs,deps,lint \"npm run test:coverage\" \"npm run test:spelling\" \"npm run test:format\" \"npm run test:docs\" \"npm run test:deps\" \"npm run test:lint\"",
        "test:coverage": "npm run test coverage",
        "test:deps": "virmator deps check",
        "test:docs": "virmator docs check",
        "test:format": "virmator format check",
        "test:lint": "virmator lint",
        "test:spelling": "virmator spellcheck",
        "test:update": "npm test update"
    },
    "dependencies": {
        "object-shape-tester": "^6.14.1"
    },
    "devDependencies": {
        "@augment-vir/assert": "^32.2.1",
        "@augment-vir/common": "^32.2.1",
        "@augment-vir/test": "^32.2.1",
        "@eslint/js": "10.0.1",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@stylistic/eslint-plugin-ts": "^4.4.1",
        "@typescript-eslint/eslint-plugin": "^8.65.0",
        "@web/dev-server-esbuild": "^2.0.0",
        "@web/test-runner": "^1.0.0",
        "@web/test-runner-playwright": "^1.0.0",
        "cspell": "^10.0.1",
        "dependency-cruiser": "^18.1.0",
        "esbuild": "^0.28.1",
        "eslint": "^10.8.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-jsdoc": "^63.3.1",
        "eslint-plugin-playwright": "^2.11.0",
        "eslint-plugin-prettier": "^5.5.6",
        "eslint-plugin-sonarjs": "^4.2.0",
        "eslint-plugin-unicorn": "^72.0.0",
        "istanbul-smart-text-reporter": "^1.1.5",
        "markdown-code-example-inserter": "^3.0.6",
        "npm-check-updates": "^23.0.0",
        "prettier": "3.3.3",
        "prettier-plugin-interpolated-html-tags": "^2.0.2",
        "prettier-plugin-jsdoc": "^1.8.1",
        "prettier-plugin-multiline-arrays": "~4.1.11",
        "prettier-plugin-organize-imports": "^4.3.0",
        "prettier-plugin-packagejson": "^3.0.2",
        "prettier-plugin-sort-json": "^4.2.0",
        "prettier-plugin-toml": "^2.0.6",
        "typedoc": "^0.28.20",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.65.0",
        "virmator": "^14.30.2"
    },
    "engines": {
        "node": ">=22"
    }
